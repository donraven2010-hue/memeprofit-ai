function drawCurve(){
  var cv = $('#eq');
  if (!cv || !paper) return;
  var pts = paper.curve;
  var dpr = window.devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight;
  cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
  var g = cv.getContext('2d');
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, w, h);
  if (pts.length < 2) return;
  var min = Infinity, max = -Infinity, i;
  for (i = 0; i < pts.length; i++){ if (pts[i].v < min) min = pts[i].v; if (pts[i].v > max) max = pts[i].v; }
  if (max === min){ max += 1; min -= 1; }
  var padR = 52, pw = w - padR;
  g.strokeStyle = '#2dd4bf'; g.lineWidth = 2; g.beginPath();
  for (i = 0; i < pts.length; i++){
    var x = i / (pts.length - 1) * pw, y = 8 + (max - pts[i].v) / (max - min) * (h - 16);
    if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
  }
  g.stroke();
  g.fillStyle = '#8a9ab5'; g.font = '11px system-ui, sans-serif';
  g.fillText('$' + max.toFixed(2), pw + 4, 12);
  g.fillText('$' + min.toFixed(2), pw + 4, h - 4);
}

