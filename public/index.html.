    box.innerHTML = list.map(function(n){
      return '<div class="rowline"><div><b>' + esc(n.title) + '</b>' + (n.is_read ? '' : ' <span class="pill on">new</span>') +
        '<div class="mut">' + esc(n.body || '') + '</div></div><small class="mut">' + esc(ago(n.created_at)) + '</small></div>';
    }).join('');
  }).catch(function(e){
    var box = $('#notes');
    if (box) box.innerHTML = '<span class="mut">Could not load notifications. ' + esc(e.message) + '</span>';
  });
}

/* ----- paper box inside the token sheet ----- */
function renderPaperBox(){
  var box = $('#paperBox');
  if (!box || !state.detail) return;
  if (!me){
    box.innerHTML = '<h3>Paper trade this token</h3><p class="mut">Log in to use your virtual $100 account. No real money is involved.</p><button type="button" class="btn primary" data-gologin="1">Log in or create account</button>';
    return;
  }
  box.innerHTML = '<h3>Paper trade (virtual money, long only)</h3>' +
    '<p class="mut">The server fetches the live price itself and checks every risk rule before opening.</p>' +
    '<div class="three">' +
    '<label class="field">Stop-loss (% below)<input id="ptSl" type="number" inputmode="decimal" value="10" min="1" max="50" step="0.5"></label>' +
    '<label class="field">Take-profit (% above)<input id="ptTp" type="number" inputmode="decimal" value="20" min="1" max="500" step="0.5"></label>' +
    '<label class="field">Size (USD)<input id="ptSize" type="number" inputmode="decimal" value="5" min="1" step="0.5"></label>' +
    '</div>' +
    '<label class="field">Why this trade? (optional)<input id="ptWhy" maxlength="200" placeholder="Short note saved with the trade"></label>' +
    '<div class="tfs"><button type="button" class="btn" data-pt="preview">Check trade</button><button type="button" class="btn primary" data-pt="open">Open paper trade</button></div>' +
    '<div id="ptOut"></div>';
}
function ptInputs(){
  var d = state.detail;
  return {net:d.net, pool:d.pool, sl_pct:Number($('#ptSl').value), tp_pct:Number($('#ptTp').value), notional:Number($('#ptSize').value), reason:$('#ptWhy').value};
}
function violHtml(list){
  return (list || []).map(function(v){ return '<div class="viol">' + esc(v.message) + '</div>'; }).join('');
}
function ptShowPreview(d){
  var h = '<div class="card">' +
    '<div class="kv">' +
    '<div><i>Live price (' + esc(ago(d.price_fetched_at)) + ')</i>' + fmtPrice(d.price) + '</div>' +
    '<div><i>Pool liquidity</i>' + fmtUsd(d.liquidity) + '</div>' +
    '<div><i>Stop-loss price</i>' + (d.stop_loss === null ? NA : fmtPrice(d.stop_loss)) + '</div>' +
    '<div><i>Take-profit price</i>' + (d.take_profit === null ? NA : fmtPrice(d.take_profit)) + '</div>' +
    '<div><i>Estimated slippage</i>' + (d.slippage_pct === null ? NA : d.slippage_pct.toFixed(2) + '%') + '</div>' +
    '<div><i>Estimated entry fee</i>' + (d.entry_fee === null ? NA : money(d.entry_fee)) + '</div>' +
    '<div><i>Max planned loss (fees and slippage included)</i>' + (d.max_planned_loss === null ? NA : money(d.max_planned_loss)) + '</div>' +
    '<div><i>Profit if take-profit hits (after costs)</i>' + (d.profit_at_take_profit === null ? NA : pnl(d.profit_at_take_profit)) + '</div>' +
    '<div><i>Biggest size allowed by the $1 rule</i>' + (d.max_size_allowed === null ? NA : money(d.max_size_allowed)) + '</div>' +
    '<div><i>Cash / lost today</i>' + money(d.cash) + ' / ' + money(d.daily_loss_so_far) + '</div>' +
    '</div></div>';
  h += d.passes ? '<div class="note ok">Passes every risk rule. Costs shown are estimates.</div>' : violHtml(d.violations);
  $('#ptOut').innerHTML = h;
}
function ptAction(kind){
  if (ptBusy || !state.detail) return;
  var body = ptInputs();
  ptBusy = true;
  $('#ptOut').innerHTML = '<span class="mut">Working…</span>';
  var req;
  if (kind === 'preview'){
    req = be('POST', '/api/paper/preview', body).then(function(j){ ptShowPreview(j.data); });
  } else {
    body.idem_key = idemKey;
    req = be('POST', '/api/paper/trade/open', body).then(function(j){
      var t = j.data.trade;
      idemKey = newKey();
      $('#ptOut').innerHTML = '<div class="note ok">' + (j.data.duplicate ? 'This trade was already opened. ' : 'Paper trade opened. ') +
        esc(t.symbol || '') + ' size ' + money(t.notional) + ', stop ' + fmtPrice(t.stop_loss) + ', target ' + fmtPrice(t.take_profit) +
        '.</div><button type="button" class="btn" data-page="paper">View in Paper trading</button>';
    });
  }
  req.catch(function(e){
    if (e.status === 401){ me = null; renderPaperBox(); return; }
    $('#ptOut').innerHTML = '<div class="note err">' + esc(e.message) + '</div>' + violHtml(e.violations);
  }).then(function(){ ptBusy = false; });
}

/* ----- system status page ----- */
function loadStatus(){
  var el = $('#statusView');
  el.innerHTML = '<div class="card">Checking the system…</div>';
  return be('GET', '/api/health').then(function(j){ renderStatus(j.data, null); })
    .catch(function(e){ renderStatus(null, e.message); });
}
function srow(label, kind, text){
  var cls = kind === 'ok' ? 'on' : (kind === 'bad' ? 'off' : '');
  return '<div class="rowline"><span>' + esc(label) + '</span><span class="pill ' + cls + '">' + esc(text) + '</span></div>';
}
function renderStatus(d, err){
  var el = $('#statusView');
  if (!d){
    el.innerHTML = '<div class="card"><h2>System status</h2><div class="note err">The backend did not answer: ' + esc(err) + '</div></div>';
    return;
  }
  var h = '<div class="card"><h2>System status</h2>' +
    srow('Backend', 'ok', 'Running') +
    srow('Database', d.database.ok ? 'ok' : 'bad', d.database.ok ? 'Connected' : 'Problem: ' + d.database.message) +
    srow('Market data (' + d.market_data.provider + ')', d.market_data.ok ? 'ok' : 'bad', d.market_data.ok ? 'Responding' : 'Failing: ' + d.market_data.message) +
    srow('Paper-trading engine', d.paper_trading.ok ? 'ok' : 'bad', d.paper_trading.ok ? 'Running' : 'Unavailable') +
    srow('Stop-loss / take-profit monitoring', d.monitoring.active ? 'ok' : 'bad', d.monitoring.active ? 'Active, last good check ' + ago(d.monitoring.last_ok) : 'Not confirmed (last good check ' + ago(d.monitoring.last_ok) + ')') +
    srow('AI agents', 'na', 'Not built yet') +
    srow('Gemini key', d.keys.gemini ? 'ok' : 'na', d.keys.gemini ? 'Configured' : 'Missing (needed for agents)') +
    srow('Web research (Exa)', d.keys.exa ? 'ok' : 'na', d.keys.exa ? 'Key configured' : 'Not configured') +
    srow('Wallet data (Helius)', d.keys.helius ? 'ok' : 'na', d.keys.helius ? 'Key configured' : 'Not configured') +
    '<p class="mut">Checked ' + esc(new Date(d.time).toLocaleTimeString()) + '. A key shown as configured only means it exists, not that it has been tested.' +
    (d.monitoring.last_error ? ' Last monitoring problem: ' + esc(d.monitoring.last_error) : '') + '</p></div>';
  el.innerHTML = h;
}

document.addEventListener('click', function(ev){
  var t = ev.target.closest('button');
  if (!t) return;
  if (t.dataset.page){ showPage(t.dataset.page); }
  else if (t.dataset.auth){ authMode = t.dataset.auth; authMsg = ''; renderPaper(); }
  else if (t.dataset.gologin){ closeDetail(); showPage('paper'); }
  else if (t.dataset.pt){ ptAction(t.dataset.pt); }
  else if (t.dataset.logout){
    be('POST', '/api/auth/logout', {}).catch(function(){}).then(function(){ me = null; paper = null; renderPaper(); });
  }
  else if (t.dataset.readall){
    be('POST', '/api/notifications/read-all', {}).then(loadNotes).catch(function(){});
  }
  else if (t.dataset.closeid){
    if (!window.confirm('Close this paper position now at the current market price?')) return;
    t.disabled = true;
    be('POST', '/api/paper/trade/close', {id:Number(t.dataset.closeid)}).then(loadPaper).catch(function(e){
      t.disabled = false;
      window.alert(e.message);
      loadPaper();
    });
  }
});
document.addEventListener('submit', function(ev){
  if (ev.target.id !== 'authForm') return;
  ev.preventDefault();
  var u = $('#auUser').value.trim(), p = $('#auPass').value;
  var btn = $('#authGo');
  btn.disabled = true;
  authMsg = '';
  be('POST', authMode === 'register' ? '/api/auth/register' : '/api/auth/login', {username:u, password:p}).then(function(j){
    me = j.data.user; backendDown = false; paper = null;
    return loadPaper();
  }).catch(function(e){
    authMsg = e.message;
    renderPaper();
  });
});
setInterval(function(){
  if (document.visibilityState === 'visible' && state.page === 'paper' && me) loadPaper();
}, 60000);

/* ---------- events ---------- */
document.addEventListener('click', function(ev){
  var t = ev.target.closest('button');
  if (!t) return;
  if (t.dataset.chain){
    state.chain = t.dataset.chain;
    load(false);
    render();
  } else if (t.dataset.view){
    state.view = t.dataset.view;
    state.query = '';
    $('#q').value = '';
    load(false);
    render();
  } else if (t.dataset.i !== undefined){
    var p = state.pools[Number(t.dataset.i)];
    if (p) openDetail(p);
  } else if (t.dataset.tf){
    state.tf = t.dataset.tf;
    renderTfs();
    loadChart(false);
  } else if (t.dataset.copy){
    copyText(t.dataset.copy, t);
  } else if (t.id === 'clearSearch'){
    state.query = '';
    $('#q').value = '';
    load(false);
    render();
  } else if (t.id === 'back'){
    closeDetail();
  } else if (t.id === 'refresh'){
    if (state.page === 'paper') { loadPaper(); }
    else if (state.page === 'status') { loadStatus(); }
    else { if (state.detail) loadChart(true); load(true); }
  }
});

$('#searchForm').addEventListener('submit', function(ev){
  ev.preventDefault();
  var q = $('#q').value.trim();
  if (q.length < 2){
    $('#banner').innerHTML = '<div class="note warn">Type at least 2 characters to search.</div>';
    return;
  }
  state.query = q;
  load(false);
  render();
});
$('#fLiq').addEventListener('change', function(){ state.minLiq = Number(this.value); render(); });
$('#fVol').addEventListener('change', function(){ state.minVol = Number(this.value); render(); });
$('#fSort').addEventListener('change', function(){ state.sort = this.value; render(); });
document.addEventListener('keydown', function(ev){ if (ev.key === 'Escape' && state.detail) closeDetail(); });
window.addEventListener('resize', function(){ if (state.detail && candles.length) drawChart(); });

setInterval(function(){
  if (document.visibilityState === 'visible' && !state.detail && state.page === 'markets') load(true);
}, AUTO_REFRESH_MS);

renderPages();
render();
load(false);
loadMe().then(function(){ if (state.detail) renderPaperBox(); });
})();
</script>
</body>
</html>
