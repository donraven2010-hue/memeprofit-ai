        return {t:Number(r[0]), o:Number(r[1]), h:Number(r[2]), l:Number(r[3]), c:Number(r[4]), v:Number(r[5]) || 0};
      }).filter(function(c){
        return isFinite(c.t) && isFinite(c.o) && isFinite(c.h) && isFinite(c.l) && isFinite(c.c);
      }).sort(function(a, b){ return a.t - b.t; });
      if (!candles.length){
        chartMsg('DATA UNAVAILABLE. The provider has no candles for this pair on the ' + state.tf + ' timeframe. Try another timeframe.');
        return;
      }
      chartMsg('');
