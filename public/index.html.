function tsLabel(t, withTime){
  var d = new Date(t * 1000);
  return withTime ? d.toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) : d.toLocaleDateString([], {month:'short', day:'numeric', year:'numeric'});
}
function showReadout(i){
  var c = candles[i];
  var el = $('#readout');
  if (!el) return;
  if (!c){ el.textContent = ''; return; }
  el.textContent = tsLabel(c.t, state.tf !== '1d') + '   O ' + priceText(c.o) + '   H ' + priceText(c.h) + '   L ' + priceText(c.l) + '   C ' + priceText(c.c) + '   Vol ' + (c.v >= 1000 ? (c.v/1000).toFixed(1) + 'K' : c.v.toFixed(0));
}

function drawChart(hoverIdx){
  var cv = $('#chart');
  if (!cv) return;
  var dpr = window.devicePixelRatio || 1;
  var w = cv.clientWidth, h = cv.clientHeight;
  cv.width = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var g = cv.getContext('2d');
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, w, h);
  if (!candles.length) return;

  var padR = 64, padT = 8, padB = 18;
  var volH = Math.round(h * 0.18);
  var pw = w - padR;
  var ph = h - padT - padB - volH - 6;
  var min = Infinity, max = -Infinity, maxV = 0, i;
  for (i = 0; i < candles.length; i++){
    if (candles[i].l < min) min = candles[i].l;
    if (candles[i].h > max) max = candles[i].h;
    if (candles[i].v > maxV) maxV = candles[i].v;
  }
  if (max === min){ max = max * 1.01; min = min * 0.99; }
  if (maxV === 0) maxV = 1;
  var n = candles.length, step = pw / n, bw = Math.max(1, step * 0.7);
  function y(p){ return padT + (max - p) / (max - min) * ph; }

  g.font = '11px system-ui, sans-serif';
  g.textBaseline = 'middle';
  g.strokeStyle = '#1f2d4a';
  g.fillStyle = '#8a9ab5';
  g.lineWidth = 1;
  for (i = 0; i <= 4; i++){
    var pr = max - (max - min) * i / 4, yy = Math.round(y(pr)) + 0.5;
    g.beginPath(); g.moveTo(0, yy); g.lineTo(pw, yy); g.stroke();
    g.fillText(priceText(pr), pw + 4, yy);
  }
  for (i = 0; i < n; i++){
    var c = candles[i], x = i * step + step / 2, up = c.c >= c.o;
    var col = up ? '#34d399' : '#f87171';
    g.strokeStyle = col; g.fillStyle = col;
    g.beginPath(); g.moveTo(Math.round(x) + 0.5, y(c.h)); g.lineTo(Math.round(x) + 0.5, y(c.l)); g.stroke();
    var top = y(Math.max(c.o, c.c)), bot = y(Math.min(c.o, c.c));
    g.fillRect(x - bw / 2, top, bw, Math.max(1, bot - top));
    g.globalAlpha = 0.35;
    var vh = c.v / maxV * volH;
    g.fillRect(x - bw / 2, h - padB - vh, bw, vh);
    g.globalAlpha = 1;
  }
  g.fillStyle = '#8a9ab5';
  g.textBaseline = 'alphabetic';
  var withTime = state.tf !== '1d';
  g.textAlign = 'left';  g.fillText(tsLabel(candles[0].t, withTime), 2, h - 3);
  g.textAlign = 'right'; g.fillText(tsLabel(candles[n - 1].t, withTime), pw, h - 3);
  g.textAlign = 'left';

  if (typeof hoverIdx === 'number' && candles[hoverIdx]){
    var hx = Math.round(hoverIdx * step + step / 2) + 0.5;
    g.strokeStyle = '#2dd4bf';
    g.setLineDash([4, 4]);
    g.beginPath(); g.moveTo(hx, padT); g.lineTo(hx, h - padB); g.stroke();
    g.setLineDash([]);
  }
}

var chartBound = false;
function bindChartEvents(){
  var cv = $('#chart');
  if (!cv) return;
  function handle(ev){
    if (!candles.length) return;
    var rect = cv.getBoundingClientRect();
    var pw = rect.width - 64;
    var i = Math.floor((ev.clientX - rect.left) / (pw / candles.length));
    i = Math.max(0, Math.min(candles.length - 1, i));
    drawChart(i);
    showReadout(i);
  }
  cv.addEventListener('pointermove', handle);
  cv.addEventListener('pointerdown', handle);
  cv.addEventListener('pointerleave', function(){ if (candles.length){ drawChart(); showReadout(candles.length - 1); } });
}

function copyText(text, btn){
  function done(ok){
    var old = btn.textContent;
    btn.textContent = ok ? 'Copied' : 'Copy failed';
    setTimeout(function(){ btn.textContent = old; }, 1400);
  }
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){ done(true); }, function(){ done(false); });
  } else {
    var ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    ta.remove(); done(ok);
  }
}

