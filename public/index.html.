function newKey(){
  if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
  return 'k' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
}
function be(method, path, body){
  var opts = {method:method, credentials:'same-origin', headers:{}};
  if (body){ opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
  return fetch(path, opts).then(function(r){
    return r.json().catch(function(){ return null; }).then(function(j){
      if (!j){
        var e0 = new Error('The server sent an unreadable reply (status ' + r.status + ').');
        e0.status = r.status;
        throw e0;
      }
      if (!r.ok || j.ok === false){
        var er = j.error || {};
        var e = new Error(er.message || ('Server error ' + r.status));
        e.code = er.code; e.violations = er.violations; e.status = r.status;
        throw e;
      }
      return j;
    });
  }, function(){
    var e = new Error('Could not reach the server. Check your connection and try again.');
    e.status = 0;
    throw e;
  });
}
function money(v){
  if (v === null || v === undefined || !isFinite(v)) return NA;
  var a = Math.abs(v);
  return (v < 0 ? '-' : '') + '$' + a.toFixed(a < 1 ? 3 : 2);
}
function pnl(v){
  if (v === null || v === undefined || !isFinite(v)) return NA;
  var a = Math.abs(v);
  var cls = v > 0 ? 'up' : (v < 0 ? 'down' : '');
  return '<span class="' + cls + '">' + (v > 0 ? '+' : (v < 0 ? '-' : '')) + '$' + a.toFixed(a < 1 ? 3 : 2) + '</span>';
}
function when(ts){ return ts ? new Date(ts).toLocaleString() : NA; }
function ago(ts){
  if (!ts) return 'never';
  var s = Math.max(0, Math.floor((Date.now() - ts) / 1000));
  if (s < 90) return s + 's ago';
  if (s < 5400) return Math.round(s / 60) + 'm ago';
  return Math.round(s / 3600) + 'h ago';
}

